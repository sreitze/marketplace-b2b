<% content_for :title, "Catálogo" %>

<h1>Catálogo</h1>

<% if @suppliers.empty? %>
  <p>Todavía no hay proveedores cargados.</p>
<% else %>
  <% @suppliers.each do |supplier| %>
    <section class="supplier-group">
      <h2><%= supplier.name %></h2>

      <% products = supplier.products.sort_by(&:name) %>
      <% if products.empty? %>
        <p>Sin productos.</p>
      <% else %>
        <table>
          <thead>
            <tr>
              <th>Producto</th>
              <th>Precio</th>
              <th>Stock</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% products.each do |product| %>
              <tr>
                <td><%= product.name %></td>
                <td><%= format_money(product.price_cents) %></td>
                <td><%= product.stock %></td>
                <td>
                  <%= form_with url: cart_items_path, method: :post do |f| %>
                    <%= f.hidden_field :product_id, value: product.id %>
                    <%= f.number_field :quantity, value: 1, min: 1, step: 1, size: 3 %>
                    <%= f.submit "Agregar al carrito" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>
<% end %>
