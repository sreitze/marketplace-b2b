<% content_for :title, "Carrito" %>

<h1>Carrito</h1>

<% if @cart_items.empty? %>
  <p>El carrito está vacío.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Producto</th>
        <th>Proveedor</th>
        <th>Precio unitario</th>
        <th>Cantidad</th>
        <th>Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <td><%= item.product.supplier.name %></td>
          <td><%= format_money(item.unit_price_cents) %></td>
          <td>
            <%= form_with url: cart_item_path(item), method: :patch do |f| %>
              <%= f.number_field :quantity, value: item.quantity, min: 1, step: 1, size: 3 %>
              <%= f.submit "Actualizar" %>
            <% end %>
          </td>
          <td><%= format_money(item.subtotal_cents) %></td>
          <td>
            <%= button_to "Quitar", cart_item_path(item), method: :delete %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p><strong>Total: <%= format_money(@cart_items.sum(&:subtotal_cents)) %></strong></p>
<% end %>

<p><%= link_to "Volver al catálogo", root_path %></p>
