<% content_for :title, "Carrito" %>

<h1>Carrito</h1>

<% if @cart_items_by_supplier.empty? %>
  <p>El carrito está vacío.</p>
<% else %>
  <% @cart_items_by_supplier.each do |supplier, items| %>
    <h2><%= supplier.name %></h2>
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Precio unitario</th>
          <th>Cantidad</th>
          <th>Subtotal</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td><%= format_money(item.unit_price_cents) %></td>
            <td>
              <%= form_with url: cart_item_path(item), method: :patch do |f| %>
                <%= f.number_field :quantity, value: item.quantity, step: "any", size: 3 %>
                <%= f.button type: "submit", title: "Actualizar", aria: { label: "Actualizar" } do %>
                  <span class="material-icons" aria-hidden="true">autorenew</span>
                <% end %>
              <% end %>
            </td>
            <td><%= format_money(item.subtotal_cents) %></td>
            <td>
              <%= button_to cart_item_path(item), method: :delete, class: "btn-danger", title: "Quitar", aria: { label: "Quitar" } do %>
                <span class="material-icons" aria-hidden="true">delete</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p>Subtotal <%= supplier.name %>: <strong><%= format_money(items.sum(&:subtotal_cents)) %></strong></p>
  <% end %>

  <p><strong>Total: <%= format_money(@cart_items_by_supplier.values.flatten.sum(&:subtotal_cents)) %></strong></p>

  <div class="cart-actions">
    <%= button_to "Confirmar orden", orders_path, method: :post, onclick: "return confirm('¿Confirmar la compra?')" %>
    <%= button_to "Vaciar carrito", cart_path, method: :delete, class: "btn-danger", onclick: "return confirm('¿Vaciar el carrito?')" %>
  </div>
<% end %>

<p><%= link_to "Volver al catálogo", root_path %></p>
